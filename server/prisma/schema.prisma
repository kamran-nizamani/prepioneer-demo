// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  name           String
  password       String             // Renamed from passwordHash for consistency
  role           String             @default("STUDENT") // STUDENT, INSTRUCTOR, ADMIN
  whatsappNumber String?            // Optional WhatsApp number in E.164 format (+1234567890)
  whatsappOptIn  Boolean            @default(false) // User must explicitly opt-in to receive messages
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  
  // AI Counseling & Personalization
  currentWeaknessProfile String?    @default("{}") // JSON: Detailed weakness map by topic/category with scores and time metrics
  studyPlanPreferences   String?    @default("{}") // JSON: User preferences for subjects, pace, study hours, goals
  
  // Relationships
  tests               Test[]
  testAttempts        TestAttempt[]
  testSessions        TestSession[]
  scheduledMessages   ScheduledMessage[]
  latEssaySubmissions LatEssaySubmission[]

  @@map("users")
}

// TestCatalog model - All competitive exams (CSS, MDCAT, ECAT, LAT, etc.)
model TestCatalog {
  id             Int           @id @default(autoincrement())
  title          String        @unique // e.g., "Central Superior Services Exam"
  acronym        String        @unique // e.g., "CSS"
  type           String        // e.g., "Admission", "Recruitment"
  conductingBody String        // e.g., "FPSC", "UET Lahore"
  description    String        // Detailed description
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  
  // Relationships
  questions      Question[]
  testSessions   TestSession[]

  @@map("test_catalog")
}

// Question model - Stores exam questions (MCQ, TRUE/FALSE, SHORT_ANSWER)
model Question {
  id             Int           @id @default(autoincrement())
  questionType   String        // MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER
  difficulty     Int           // Difficulty level (1-5)
  category       String        // e.g., "Physics", "Biology", "Mathematics"
  questionText   String        // Main question text
  options        String?       // JSON array of options (for MULTIPLE_CHOICE)
  correctAnswer  String        // The correct answer
  explanation    String?       // Detailed explanation of the answer
  createdAt      DateTime      @default(now())
  
  // NEW: Link to TestCatalog
  testCatalogId  Int?
  testCatalog    TestCatalog?  @relation(fields: [testCatalogId], references: [id])
  
  // Relationships
  tests          Test[]        @relation("TestQuestions")

  @@map("questions")
}

// Test model - Created by instructors or generated by AI
model Test {
  id            String        @id @default(cuid())
  userId        Int           // Creator (instructor or system)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String        // e.g., "Physics Mock Test 1"
  subject       String        // e.g., "Physics", "Biology"
  difficulty    Int           // Average difficulty (1-5)
  numQuestions  Int           // Total number of questions
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relationships
  questions     Question[]    @relation("TestQuestions")
  attempts      TestAttempt[]

  @@map("tests")
}

// TestSession model - Tracks active test sessions with AI-generated questions
model TestSession {
  id              String    @id @default(cuid())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  testName        String    // e.g., "Physics - 2025-11-18"
  topic           String    // e.g., "Mathematics - Calculus"
  questions       String    // JSON: Complete questions with answers (immutable)
  answers         String    // JSON: Student's submitted answers
  
  // NEW: Link to TestCatalog for analytics
  testCatalogId   Int?
  testCatalog     TestCatalog?  @relation(fields: [testCatalogId], references: [id])
  
  status          String    @default("PENDING") // PENDING, COMPLETED
  scorePercentage Float?    // Final score percentage (0-100)
  feedbackSummary String?   // AI-generated feedback
  
  startTime       DateTime  @default(now())
  endTime         DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("test_sessions")
}

// TestAttempt model - Tracks student test attempts
model TestAttempt {
  id              Int       @id @default(autoincrement())
  testId          String
  test            Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  answers         String    // JSON: Student's submitted answers { questionId: answer }
  score           Float?    // Final score (e.g., 75.5)
  totalQuestions  Int       // Total questions in this attempt
  correctAnswers  Int?      // Number of correct answers
  
  categoryScores  String?   // JSON: Category-wise scores { "Physics": 80, "Biology": 70 }
  
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  
  @@map("test_attempts")
}

// ScheduledMessage model - WhatsApp message queue
model ScheduledMessage {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messageType     String    // "REMINDER", "RESULT", "NOTIFICATION"
  messageBody     String    // The message text to send
  recipientNumber String    // WhatsApp number in E.164 format
  
  scheduledFor    DateTime  // When to send the message
  sentAt          DateTime? // When the message was actually sent
  status          String    // "PENDING", "SENT", "FAILED"
  
  createdAt       DateTime  @default(now())
  
  @@map("scheduled_messages")
}

// LatEssaySubmission model - Stores LAT essay submissions with grading
model LatEssaySubmission {
  id                String    @id @default(cuid())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  topic             String    // Essay topic/prompt
  essayText         String    // Full essay text submitted by student
  essayLength       Int       // Character count
  wordCount         Int       // Word count
  
  // Grading results
  overallScore      Float     // 0-10 score
  thesisScore       Int       // Raw score 1-10
  organizationScore Int       // Raw score 1-10
  evidenceScore     Int       // Raw score 1-10
  analysisScore     Int       // Raw score 1-10
  languageScore     Int       // Raw score 1-10
  
  feedback          String    // JSON array of feedback bullets
  sampleIntro       String?   // Sample introduction
  sampleConclusion  String?   // Sample conclusion
  improvedEssay     String?   // Full improved essay example
  
  submittedAt       DateTime  @default(now())
  
  @@map("lat_essay_submissions")
}
