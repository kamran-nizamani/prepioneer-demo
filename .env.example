# PrepPioneer Environment Variables Template
# Copy this file to server/.env and fill in your actual values

# ====================================
# Server Configuration
# ====================================
PORT=5000
NODE_ENV=development

# ====================================
# Database Configuration
# ====================================
# SQLite (for development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production - uncomment and configure)
# DATABASE_URL="postgresql://username:password@localhost:5432/prepioneer_db?schema=public"

# ====================================
# JWT Authentication
# ====================================
# IMPORTANT: Change this to a strong, random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# ====================================
# OpenAI API Configuration
# ====================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ====================================
# Twilio WhatsApp Configuration
# ====================================
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# WhatsApp-enabled Twilio phone number
# Format: whatsapp:+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ====================================
# Client Configuration
# ====================================
# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production: https://your-production-domain.com
CLIENT_URL=http://localhost:5173

# ====================================
# Optional: Email Configuration (for future features)
# ====================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ====================================
# Optional: Redis Configuration (for caching/sessions)
# ====================================
# REDIS_URL=redis://localhost:6379

# ====================================
# Security Configuration
# ====================================
# Rate limiting (requests per minute)
RATE_LIMIT=100

# JWT token expiration
JWT_EXPIRATION=24h

# ====================================
# Feature Flags
# ====================================
# Enable/disable features
ENABLE_WHATSAPP_SCHEDULER=true
ENABLE_ANALYTICS=true
ENABLE_LAT_ESSAY_GRADER=true

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL=info
# Options: error, warn, info, debug, verbose

# ====================================
# NOTES
# ====================================
# 1. Never commit .env files to version control
# 2. Use different values for dev/staging/production
# 3. Rotate secrets regularly (quarterly recommended)
# 4. Use a password manager for sensitive values
# 5. For production, use secrets management service (AWS Secrets Manager, Azure Key Vault, etc.)
